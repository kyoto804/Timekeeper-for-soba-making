<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <!-- ★ 上部に説明文を表示 -->
        <TextView
            android:id="@+id/headerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="経過時間(秒)　メッセージ1　メッセージ2"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingBottom="20dp"
            android:background="#000000"/>
        <!-- ★ セット1 -->
        <EditText
            android:id="@+id/minA"
            android:hint="秒数（例：600）"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgA1"
            android:hint="メッセージ1（例：10分経過）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgA2"
            android:hint="メッセージ2（例：10分経過です）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ★ セット2 -->
        <EditText
            android:id="@+id/minB"
            android:hint="秒数（例：1200）"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgB1"
            android:hint="メッセージ1（例：20分経過）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgB2"
            android:hint="メッセージ2（例：20分経過です）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ★ セット3 -->
        <EditText
            android:id="@+id/minC"
            android:hint="秒数（例：1800）"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgC1"
            android:hint="メッセージ1（例：30分経過）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/msgC2"
            android:hint="メッセージ2（例：30分経過です）"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <!-- 下に余白 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#000000"/>
            
        <!-- 保存 -->
        <Button
            android:id="@+id/saveBtn"
            android:text="保存"
            android:textSize="20sp"
            android:layout_marginTop="24dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 初期値に戻す -->
        <Button
            android:id="@+id/resetBtn"
            android:text="初期値に戻す"
            android:textSize="20sp"
            android:layout_marginTop="12dp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
