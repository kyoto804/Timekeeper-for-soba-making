<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <!-- ★ 上余白 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#000000" />
            
        <!-- ★ フォント倍率（SeekBar） -->
        <TextView
            android:id="@+id/fontScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="フォント倍率: 1.0"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/fontScaleSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- ★ 終了時間選択（40 / 35 / 30） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="終了時間　40分　35分　30分"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingBottom="8dp" />
        
        <RadioGroup
            android:id="@+id/finishGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#404040"
            android:gravity="center">
        
            <RadioButton
                android:id="@+id/rb40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40分"
                android:textColor="#000000"
                android:button="@null"
                android:padding="12dp"
                android:background="@drawable/radio_segment"
                android:layout_marginEnd="8dp" />
        
            <RadioButton
                android:id="@+id/rb35"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35分"
                android:textColor="#000000"
                android:button="@null"
                android:padding="12dp"
                android:background="@drawable/radio_segment"
                android:layout_marginEnd="8dp" />
        
            <RadioButton
                android:id="@+id/rb30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30分"
                android:textColor="#000000"
                android:button="@null"
                android:padding="12dp"
                android:background="@drawable/radio_segment" />
        </RadioGroup>
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="カウントダウン秒数"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/countdownSec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例：5"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />
            
        <!-- ★ 上部説明文 -->
        <TextView
            android:id="@+id/headerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="経過時間(秒)　メッセージ1　メッセージ2"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingBottom="20dp"
            android:background="#000000" />

        <!-- ============================================================ -->
        <!-- ★ セット1 -->
        <!-- ============================================================ -->
        <EditText
            android:id="@+id/minA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秒数（例：600）"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgA1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ1（例：10分経過）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgA2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ2（例：10分経過です）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <!-- ============================================================ -->
        <!-- ★ セット2 -->
        <!-- ============================================================ -->
        <EditText
            android:id="@+id/minB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秒数（例：1200）"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgB1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ1（例：20分経過）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgB2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ2（例：20分経過です）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <!-- ============================================================ -->
        <!-- ★ セット3 -->
        <!-- ============================================================ -->
        <EditText
            android:id="@+id/minC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="秒数（例：1800）"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgC1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ1（例：30分経過）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <EditText
            android:id="@+id/msgC2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="メッセージ2（例：30分経過です）"
            android:textColor="#000000"
            android:background="@drawable/edittext_white" />

        <!-- ★ 下余白 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="#000000" />
            
        <!-- ★ 音声ガイド ON/OFF -->
        <Switch
            android:id="@+id/soundSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="音声ガイドを使う"
            android:textColor="#FFFFFF"
            android:paddingTop="20dp"
            android:paddingBottom="10dp" />
            
        <!-- ★ 保存 -->
        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333"
            android:layout_marginTop="24dp" />

        <!-- ★ 初期値に戻す -->
        <Button
            android:id="@+id/resetBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="初期値に戻す"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#333333"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
